# Copy to .env.local. Never commit real values.
# `neon checkout dev` fills the DATABASE_URL* and NEON_* variables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Must match the browser origin exactly (no trailing slash).
# Local: http://localhost:3000
# Prod:  https://gitlingo.ayushlabs.tech
BETTER_AUTH_URL=http://localhost:3000


# Google OAuth (optional). Create a Web client in Google Cloud Console.
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 to show the "Continue with Google" button on login/signup.
NEXT_PUBLIC_GOOGLE_AUTH=1

# Who may open /admin. Comma-separated emails. Sign up with this email yourself first.
ADMIN_EMAIL=
